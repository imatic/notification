{
    "name": "imatic/notification",
    "type": "library",
    "description": "Simple library for sending reliable messages among apps",
    "keywords": [],
    "homepage": "http://imatic.cz",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "php-amqplib/php-amqplib": "^3.1.0",
        "symfony/options-resolver": "^8.1",
        "psr/log": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpmd/phpmd": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "suggest": {
        "symfony/symfony": "Great framework with container able to create connection object for you"
    },
    "autoload": {
        "psr-4": {
            "Imatic\\Notification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Imatic\\Notification\\Test\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
